{
  "name": "exittrace",
  "version": "1.0.0",
  "private": false,
  "type": "module",
  "description": "Sourced tracker of public-role exits and official government dog-comms since 2017.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "jpeg-js": "^0.4.4",
    "pg": "^8.13.1",
    "pngjs": "^7.0.0"
  },
  "scripts": {
    "start": "node app/server.mjs",
    "seed": "node scripts/import-seed.mjs",
    "import-posts": "node scripts/import-source-posts.mjs",
    "promote": "node scripts/promote-source-post.mjs",
    "add-process": "node scripts/process-add-request.mjs",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "thumbs": "node scripts/build-thumbs.mjs",
    "pack": "bash scripts/pack-data.sh",
    "fetch-data": "bash scripts/fetch-data.sh"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/areveur51/ExitTrace.git"
  },
  "keywords": [
    "journalism",
    "public-records",
    "exits",
    "dog-comms"
  ]
}

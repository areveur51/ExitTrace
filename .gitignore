# Dependencies
node_modules/

# Local secrets and machine config — never commit
.env
.env.local
.env.*.local
*.pem
auth.json

# Process / logs
*.log
*.pid
*.supervise.pid

# Generated file-store copy (seed JSON in data/seed.json is the portable import)
data/store.json

# Host-local JSONL import packs. Pass a path to the import script; do not commit.
var/

# In-progress thumb writes
media/thumbs/**/*.tmp

# scratch/ holds per-case working files and must never hold browser profiles
# or credentials. Tracked files already under scratch/ stay tracked (git keeps
# tracking them). New files there need `git add -f`. The specific scratch/...
# lines below are redundant and are left in place.
# /.worktrees/ is local linked worktrees only, not source.
/scratch/
/.worktrees/

# Local portrait review downloads and helper packages. Not catalog source.
scratch/portrait-review/
scratch/pydeps/

# One-shot lab export for the gap upsert, and the local helpers that copy it. Not source.
scratch/published-gap.json
scratch/pg-date-preload.mjs
scratch/render-check.py
scratch/render-ids.mjs
scratch/remove-fixture.mjs
scratch/stream-diag.mjs
scratch/stream-ctl.mjs
scratch/stream-reach.txt
scratch/postgres-5432.yml
scratch/stream-reset.mjs

# One-shot roll-call working files for the harassment-records tag. Not source.
scratch/harassment-records/

# Packaged release zip — published via GitHub Releases, not git
dist/
*.zip
*.zip.sha256

# Local TLS material
tls/*.key
tls/*.crt

.DS_Store

# Dependencies
node_modules/

# Local secrets and machine config — never commit
.env
.env.local
.env.*.local
*.pem
auth.json

# Process / logs
*.log
*.pid
*.supervise.pid

# Generated file-store copy (seed JSON in data/seed.json is the portable import)
data/store.json

# Host-local JSONL import packs. Pass a path to the import script; do not commit.
var/

# In-progress thumb writes
media/thumbs/**/*.tmp

# scratch/ holds per-case working files and must never hold browser profiles
# or credentials. Tracked files already under scratch/ stay tracked (git keeps
# tracking them). New files there need `git add -f`. One /scratch/ rule
# replaces the old per-request scratch/... lines (#228).
# /.worktrees/ is local linked worktrees only, not source.
/scratch/
/.worktrees/

# Packaged release zip — published via GitHub Releases, not git
dist/
*.zip
*.zip.sha256

# Local TLS material
tls/*.key
tls/*.crt

.DS_Store

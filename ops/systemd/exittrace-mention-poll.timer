# Coarse mention poll. 10 minutes is inside the 5–15 minute band.
# The worker timer starts about 3 minutes later (OnBootSec=8min).
# Do not tighten OnUnitActiveSec for HTTP 402/429. Backoff stays in the poll process.
[Unit]
Description=ExitTrace X mention poll cadence

[Timer]
OnBootSec=5min
OnUnitActiveSec=10min
AccuracySec=1min
Persistent=true
Unit=exittrace-mention-poll.service

[Install]
WantedBy=timers.target

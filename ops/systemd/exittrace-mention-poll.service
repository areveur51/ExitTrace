# Host timer unit. Fill __INSTALL_PREFIX__ with scripts/install-mention-units.mjs.
# GitHub Actions does not run this unit.
# EnvironmentFile holds the names in docs/X_MENTION_QUEUE.md. Do not commit that file.
[Unit]
Description=ExitTrace X mention poll
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=__INSTALL_PREFIX__
EnvironmentFile=-/etc/exittrace/mention.env
ExecStart=/usr/bin/node __INSTALL_PREFIX__/scripts/x-mention-poll.mjs --once

# Copy to .env (optional). Defaults work for a local checkout.
PORT=5220
HOST=0.0.0.0

# Directory of stored portraits and dog-comm stills
MEDIA_DIR=./media

# File-store directory used when DATABASE_URL is unset
DATA_DIR=./data

# Optional Postgres. File fallback is the default.
# Use your own URL; never commit .env.
# DATABASE_URL=postgres://USER:PASS@127.0.0.1:5433/exittrace

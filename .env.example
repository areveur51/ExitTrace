# Copy to .env (optional). Defaults work for a local checkout.
PORT=5220
HOST=0.0.0.0

# Directory of stored portraits and dog-comm stills
MEDIA_DIR=./media

# File-store directory used when DATABASE_URL is unset
DATA_DIR=./data

# Optional Postgres. File fallback is the default.
# Use your own URL; never commit .env.
# DATABASE_URL=postgres://USER:PASS@127.0.0.1:5433/exittrace

# X mention queue. Names only — set values on the host, never commit them.
# Render app: MENTION_QUEUE_BOT_TOKEN MENTION_QUEUE_WORKER_TOKEN EXITTRACE_PUBLIC_ORIGIN
# Mention poll host: X_API_KEY X_API_SECRET X_ACCESS_TOKEN X_ACCESS_TOKEN_SECRET X_USER_ID
#   MENTION_QUEUE_URL MENTION_QUEUE_BOT_TOKEN MENTION_POLL_MS MENTION_SOFT_ACK MENTION_STATE_PATH
# MENTION_SOFT_ACK is off unless set to 1. It posts only for a newly created queue row.
# Worker host: MENTION_QUEUE_URL MENTION_QUEUE_WORKER_TOKEN MENTION_WORKER_DATABASE
#   MENTION_DIG_COMMAND MENTION_CLAIM_OWNER MENTION_CLAIM_LEASE_MS MENTION_WORKER_POLL_MS
#   DATABASE_URL (lab) X_API_KEY X_API_SECRET X_ACCESS_TOKEN X_ACCESS_TOKEN_SECRET X_USER_ID
# Shared limits: MENTION_AUTHOR_MAX MENTION_AUTHOR_WINDOW_MS MENTION_BLOCKLIST MENTION_INSTALL_PREFIX
